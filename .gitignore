cargo-lock/

# rust-analyzer persistent state
.rust-analyzer/

# Editor/IDE-specific files
# VS Code
.vscode/
# JetBrains IDEs (RustRover, CLion, etc.)
__pycache__/
output/
docs/superpowers/

AGENTS.md
docs/superpowers/

# Generated C# bindings (regenerated by build.py via uniffi-bindgen-cs).
/app/Localref.Desktop/Generated/localref_ffi.cs
# .NET build output
/app/**/bin/
/app/**/obj/
# JetBrains IDE config (per-developer, not tracked)
/app/.idea/
