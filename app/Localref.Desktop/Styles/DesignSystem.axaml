<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Primitive and semantic tokens. Keep views free of one-off color values. -->
    <Color x:Key="Color.Canvas">#F4F6F8</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.Surface.Subtle">#F8FAFC</Color>
    <Color x:Key="Color.Surface.Selected">#E8F1FF</Color>
    <Color x:Key="Color.Selection">#CFE2FF</Color>
    <Color x:Key="Color.Border">#DCE2E9</Color>
    <Color x:Key="Color.Border.Strong">#C6CFDA</Color>
    <Color x:Key="Color.Text">#19212B</Color>
    <Color x:Key="Color.Text.Muted">#66717E</Color>
    <Color x:Key="Color.Accent">#2563EB</Color>
    <Color x:Key="Color.Accent.Hover">#1D4ED8</Color>
    <Color x:Key="Color.Accent.Soft">#DBEAFE</Color>
    <Color x:Key="Color.Success">#16865C</Color>
    <Color x:Key="Color.Danger">#C33B48</Color>

    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{StaticResource Color.Surface.Subtle}" />
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Color.Accent.Soft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

    <x:Double x:Key="Space.100">4</x:Double>
    <x:Double x:Key="Space.200">8</x:Double>
    <x:Double x:Key="Space.300">12</x:Double>
    <x:Double x:Key="Space.400">16</x:Double>
    <x:Double x:Key="Space.500">24</x:Double>
    <CornerRadius x:Key="Radius.Control">7</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="Inter" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.subtle-card">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Selection}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="ListBox.library-table">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.library-table > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.library-table > ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
  </Style>
  <Style Selector="ListBox.library-table > ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
  </Style>

  <Style Selector="DataGrid.library-grid">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="44" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridCell">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridRow:selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridRow:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridRow:selected:not(:focus)">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridRow:selected:pointerover:not(:focus)">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridRow:selected DataGridCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridCell:selected">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridCell:current">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridCell:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="DataGrid.library-grid DataGridCell:selected:current">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <Style Selector="TabControl.inspector">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabControl.inspector TabItem">
    <Setter Property="Padding" Value="11,9" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
