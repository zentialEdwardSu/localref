<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Localref.Desktop.ViewModels"
        xmlns:views="using:Localref.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560"
        d:DesignHeight="520"
        x:Class="Localref.Desktop.Views.PluginPageWindow"
        x:DataType="vm:PluginPageWindowViewModel"
        Icon="/Assets/localref.ico"
        Width="560"
        Height="520"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Title="{Binding PageLabel}">

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" Padding="18,14">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding PageLabel}" Classes="h1" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding PluginName}" Foreground="{DynamicResource Brush.Accent}"
                     FontSize="11" FontWeight="SemiBold" />
          <TextBlock Text="·" Classes="muted" FontSize="11" />
          <TextBlock Text="{Binding ContextSummary}" Classes="muted" FontSize="11" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource Brush.Surface.Subtle}">
      <views:PluginPageView DataContext="{Binding Page}" Margin="10" />
    </ScrollViewer>
  </Grid>
</Window>
