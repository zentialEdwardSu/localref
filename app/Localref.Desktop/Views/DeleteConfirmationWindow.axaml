<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Localref.Desktop.Views.DeleteConfirmationWindow"
        Icon="/Assets/localref.ico"
        Width="460"
        Height="230"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Delete references?">

  <Grid RowDefinitions="*,Auto" Margin="24">
    <StackPanel Spacing="12">
      <TextBlock Text="Delete references?" FontSize="20" FontWeight="SemiBold" />
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
      <TextBlock Text="This action cannot be undone."
                 Classes="muted" FontSize="11" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8">
      <Button Classes="secondary" Content="Cancel" Click="OnCancelClick" />
      <Button Classes="danger" Content="Delete" Click="OnDeleteClick" />
    </StackPanel>
  </Grid>
</Window>
