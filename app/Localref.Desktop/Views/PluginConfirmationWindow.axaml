<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Localref.Desktop.Views"
        x:Class="Localref.Desktop.Views.PluginConfirmationWindow"
        x:DataType="views:PluginConfirmationWindow"
        Icon="/Assets/localref.ico"
        Width="460" Height="240" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Title="Confirm plugin action">
  <Grid RowDefinitions="*,Auto" Margin="24">
    <StackPanel Spacing="12">
      <TextBlock Text="{CompiledBinding DialogTitle}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{CompiledBinding DialogMessage}" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="secondary" Content="Cancel" Click="OnCancelClick"
              AutomationProperties.Name="Cancel plugin action" />
      <Button Content="{CompiledBinding ConfirmLabel}" Classes="primary" Click="OnConfirmClick"
              AutomationProperties.Name="Confirm plugin action" />
    </StackPanel>
  </Grid>
</Window>
