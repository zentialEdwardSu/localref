<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The generated UniFFI bindings use `unsafe` and P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- RID stays parameterizable; win-x64 is the first target. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Update="Assets\localref.ico"
          CopyToOutputDirectory="PreserveNewest"
          Link="localref.ico" />
  </ItemGroup>

  <!-- Copy the Rust cdylib next to the exe so DllImport("localref_ffi") resolves.
       build.py rebuilds it; the path follows the active cargo profile. -->
  <ItemGroup>
    <None Include="..\..\target\debug\localref_ffi.dll"
          Condition="'$(Configuration)' == 'Debug'"
          CopyToOutputDirectory="PreserveNewest"
          Link="localref_ffi.dll" />
    <None Include="..\..\target\release\localref_ffi.dll"
          Condition="'$(Configuration)' == 'Release'"
          CopyToOutputDirectory="PreserveNewest"
          Link="localref_ffi.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>
</Project>
